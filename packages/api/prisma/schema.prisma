generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String    @id @default(uuid())
  name      String
  address   String
  phone     String
  email     String    @unique
  createdAt DateTime  @default(now())
  admins    Admin[]
  patients  Patient[]
}

model Admin {
  id           String     @id @default(uuid())
  clinicId     String
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role       @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  auditLogs    AuditLog[]
}

model Patient {
  id            String        @id @default(uuid())
  clinicId       String
  email         String        @unique
  passwordHash  String
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  clinic        Clinic        @relation(fields: [clinicId], references: [id])
  healthProfile HealthProfile?
  generatedPlan GeneratedPlan?
  dailyLogs     DailyLog[]
  auditLogs     AuditLog[]
}

model HealthProfile {
  id                      String        @id @default(uuid())
  patientId               String        @unique
  heightCm                Float
  weightKg                Float
  targetWeightKg          Float
  bmi                     Float
  ldlMgDl                 Float?
  hdlMgDl                 Float?
  triglyceridesMgDl       Float?
  fastingGlucoseMgDl      Float?
  hba1cPercent            Float?
  isDiabetic              Boolean       @default(false)
  systolicBp              Int?
  diastolicBp             Int?
  activityLevel           ActivityLevel
  dietStyle               DietStyle
  dietaryRestrictions     String[]
  allergies               String[]
  medicalConditions       String[]
  medications             String[]
  includeAyurvedic        Boolean       @default(false)
  includeAntiInflammatory Boolean       @default(false)
  bmr                     Float
  tdee                    Float
  dailyCalorieTarget      Float
  dailyProteinG           Float
  dailyCarbsG             Float
  dailyFatG               Float
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  patient                 Patient       @relation(fields: [patientId], references: [id])
}

model GeneratedPlan {
  id              String     @id @default(uuid())
  patientId       String     @unique
  generatedAt     DateTime   @default(now())
  regeneratedAt   DateTime?
  generatedBy     String
  status          PlanStatus @default(ACTIVE)
  totalDays       Int        @default(90)
  startDate       DateTime
  aiModel         String
  dietPlan        Json
  exercisePlan    Json
  ayurvedicNotes  Json?
  dietPdfPath     String?
  exercisePdfPath String?
  patient         Patient    @relation(fields: [patientId], references: [id])
}

model DailyLog {
  id               String   @id @default(uuid())
  patientId        String
  logDate          DateTime @db.Date
  dayNumber        Int
  breakfastDone    Boolean  @default(false)
  lunchDone        Boolean  @default(false)
  dinnerDone       Boolean  @default(false)
  snack1Done       Boolean  @default(false)
  snack2Done       Boolean  @default(false)
  waterLitres      Float?
  mealNotes        String?
  exerciseDone     Boolean  @default(false)
  exerciseDuration Int?
  exerciseNotes    String?
  weightKg         Float?
  energyLevel      Int?
  mood             Int?
  syncedAt         DateTime?
  createdOffline   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patient          Patient  @relation(fields: [patientId], references: [id])

  @@unique([patientId, logDate])
}

model AuditLog {
  id           String      @id @default(uuid())
  timestamp    DateTime    @default(now())
  actorId      String
  actorRole    Role
  action       AuditAction
  resourceType String
  resourceId   String?
  ipAddress    String
  userAgent    String
  adminId      String?
  patientId    String?
  admin        Admin?      @relation(fields: [adminId], references: [id])
  patient      Patient?    @relation(fields: [patientId], references: [id])

  @@index([timestamp])
  @@index([actorId])
  @@index([resourceType, resourceId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userRole  Role
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, userRole])
}

enum Role {
  ADMIN
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum DietStyle {
  MEDITERRANEAN
  KETO
  LOW_CARB
  LOW_CHOLESTEROL
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  INDIAN
  INDIAN_VEGETARIAN
  INDIAN_VEGAN
  DIABETIC_FRIENDLY
  BALANCED
}

enum PlanStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  VIEW_PATIENT
  CREATE_PATIENT
  UPDATE_PATIENT
  VIEW_HEALTH_PROFILE
  UPDATE_HEALTH_PROFILE
  GENERATE_PLAN
  VIEW_PLAN
  EXPORT_PDF
  UPDATE_DAILY_LOG
  REVOKE_ACCESS
}
