generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String    @id @default(uuid())
  name      String
  address   String
  phone     String
  email     String    @unique
  createdAt DateTime  @default(now())
  admins    Admin[]
  patients  Patient[]
}

model Admin {
  id           String     @id @default(uuid())
  clinicId     String
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role       @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  auditLogs    AuditLog[]
}

model Patient {
  id                String             @id @default(uuid())
  clinicId          String
  email             String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clinic            Clinic             @relation(fields: [clinicId], references: [id])
  healthProfile     HealthProfile?
  generatedPlan     GeneratedPlan?
  dailyLogs         DailyLog[]
  auditLogs         AuditLog[]
  pushSubscriptions PushSubscription[]
  foodEntries       FoodEntry[]
  glucoseReadings   GlucoseReading[]

  // Daily log reminder preferences
  reminderEnabled      Boolean   @default(false)
  reminderTime         String? // "HH:MM", 24h, interpreted in reminderTimezone
  reminderTimezone     String? // IANA tz, e.g. "America/New_York"
  reminderLastSentDate DateTime? @db.Date
}

model PushSubscription {
  id        String   @id @default(uuid())
  patientId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model HealthProfile {
  id                      String        @id @default(uuid())
  patientId               String        @unique
  heightCm                Float
  weightKg                Float
  targetWeightKg          Float
  bmi                     Float
  // Encrypted at rest (AES-256-GCM, see utils/encryption.ts) — stored as ciphertext strings,
  // encrypted/decrypted at the route-handler boundary. Values are numbers/arrays over the API.
  ldlMgDl                 String?
  hdlMgDl                 String?
  triglyceridesMgDl       String?
  fastingGlucoseMgDl      String?
  hba1cPercent            String?
  isDiabetic              Boolean       @default(false)
  // Waist / abdomen circumference in inches — encrypted like the other measurements.
  abdomenIn               String?
  // Clinician recommendations shown to the patient and fed to plan generation — encrypted.
  clinicianNotes          String?
  // true once a clinician has set the calorie/macro targets by hand; profile edits then keep them.
  targetsOverridden       Boolean       @default(false)
  systolicBp              String?
  diastolicBp             String?
  activityLevel           ActivityLevel
  dietStyle               DietStyle
  dietaryRestrictions     String[]
  allergies               String?
  medicalConditions       String?
  medications             String?
  includeAyurvedic        Boolean       @default(false)
  includeAntiInflammatory Boolean       @default(false)
  bmr                     Float
  tdee                    Float
  dailyCalorieTarget      Float
  dailyProteinG           Float
  dailyCarbsG             Float
  dailyFatG               Float
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  patient                 Patient       @relation(fields: [patientId], references: [id])
}

model GeneratedPlan {
  id              String     @id @default(uuid())
  patientId       String     @unique
  generatedAt     DateTime   @default(now())
  regeneratedAt   DateTime?
  generatedBy     String
  status          PlanStatus @default(ACTIVE)
  totalDays       Int        @default(90)
  startDate       DateTime
  aiModel         String
  dietPlan        Json
  exercisePlan    Json
  ayurvedicNotes  Json?
  dietPdfPath     String?
  exercisePdfPath String?
  patient         Patient    @relation(fields: [patientId], references: [id])
}

model FoodEntry {
  id            String        @id @default(uuid())
  patientId     String
  logDate       DateTime      @db.Date
  mealType      MealType
  name          String
  quantity      Float
  unit          String
  calories      Float
  carbsG        Float         @default(0)
  proteinG      Float         @default(0)
  fatG          Float         @default(0)
  plateCategory PlateCategory
  // Approximate food volume in cups — the plate method is a volume guide (1/2 veg, 1/4 protein, 1/4 carb).
  volumeCups    Float         @default(0)
  source        FoodSource    @default(MANUAL)
  createdAt     DateTime      @default(now())
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, logDate])
}

model GlucoseReading {
  id         String         @id @default(uuid())
  patientId  String
  logDate    DateTime       @db.Date
  measuredAt DateTime
  // mg/dL, encrypted at rest (AES-256-GCM) like the other lab values.
  valueMgDl  String
  context    GlucoseContext
  createdAt  DateTime       @default(now())
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, logDate])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum PlateCategory {
  NONSTARCHY_VEG
  PROTEIN
  CARB
  FAT_OTHER
  DRINK
}

enum FoodSource {
  MANUAL
  AI_TEXT
  AI_PHOTO
}

enum GlucoseContext {
  FASTING
  BEFORE_MEAL
  AFTER_MEAL
  BEDTIME
  OTHER
}

model DailyLog {
  id               String    @id @default(uuid())
  patientId        String
  logDate          DateTime  @db.Date
  dayNumber        Int
  breakfastDone    Boolean   @default(false)
  lunchDone        Boolean   @default(false)
  dinnerDone       Boolean   @default(false)
  snack1Done       Boolean   @default(false)
  snack2Done       Boolean   @default(false)
  waterLitres      Float?
  mealNotes        String?
  exerciseDone     Boolean   @default(false)
  exerciseDuration Int?
  exerciseNotes    String?
  weightKg         Float?
  energyLevel      Int?
  mood             Int?
  syncedAt         DateTime?
  createdOffline   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  patient          Patient   @relation(fields: [patientId], references: [id])

  @@unique([patientId, logDate])
}

model AuditLog {
  id           String      @id @default(uuid())
  timestamp    DateTime    @default(now())
  actorId      String
  actorRole    Role
  action       AuditAction
  resourceType String
  resourceId   String?
  ipAddress    String
  userAgent    String
  adminId      String?
  patientId    String?
  admin        Admin?      @relation(fields: [adminId], references: [id])
  patient      Patient?    @relation(fields: [patientId], references: [id])

  @@index([timestamp])
  @@index([actorId])
  @@index([resourceType, resourceId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userRole  Role
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, userRole])
}

enum Role {
  ADMIN
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum DietStyle {
  MEDITERRANEAN
  KETO
  LOW_CARB
  LOW_CHOLESTEROL
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  INDIAN
  INDIAN_VEGETARIAN
  INDIAN_VEGAN
  DIABETIC_FRIENDLY
  BALANCED
}

enum PlanStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  VIEW_PATIENT
  CREATE_PATIENT
  UPDATE_PATIENT
  VIEW_HEALTH_PROFILE
  UPDATE_HEALTH_PROFILE
  GENERATE_PLAN
  VIEW_PLAN
  EXPORT_PDF
  UPDATE_DAILY_LOG
  REVOKE_ACCESS
}
