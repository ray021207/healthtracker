# packages/api/.env
DATABASE_URL=postgresql://user:PASSWORD@host:5432/monark_health?sslmode=require
ANTHROPIC_API_KEY=sk-ant-apI_XXXXXXXXXXXX
JWT_ACCESS_SECRET=<64-char-random>
JWT_REFRESH_SECRET=<64-char-random>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=<32-byte-hex>
SEED_ADMIN_PASSWORD=Admin@12345
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://admin.monarkhealth.com,exp://...
# Daily log reminder push notifications — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Reuse the same pair forever; regenerating invalidates every existing patient subscription.
VAPID_PUBLIC_KEY=<generated-public-key>
VAPID_PRIVATE_KEY=<generated-private-key>
VAPID_SUBJECT=mailto:support@monarkhealth.com

# apps/admin/.env
VITE_API_URL=https://api.monarkhealth.com
VITE_PATIENT_PORTAL_URL=https://app.monarkhealth.com

# apps/mobile/.env
EXPO_PUBLIC_API_URL=https://api.monarkhealth.com
